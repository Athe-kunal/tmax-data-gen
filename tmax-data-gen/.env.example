# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- OpenAI-compatible generation endpoint (data_gen/inference_config.py) ---
# Standard OPENAI_* names so switching providers later (OpenAI itself, a
# self-hosted vLLM/MLX server, Weave Inference, Azure, ...) is just editing
# these values - no code change.

# API key for the endpoint. Required. For W&B Weave Inference, get one at
# https://wandb.ai/settings.
OPENAI_API_KEY=

# Endpoint base URL. Leave unset to use Weave Inference's default
# (see data_gen/config/inference.yaml's `base_url`).
OPENAI_BASE_URL=

# Model ID. Leave unset to use config/inference.yaml's `default_model`.
OPENAI_MODEL=

# Optional "<team>/<project>", sent as the OpenAI-Project header. Weave
# Inference uses this for usage attribution; harmless/ignored elsewhere.
OPENAI_PROJECT=

# --- Embeddings for KG retrieval (data_gen/embeddings.py, kg_retrieve.py) ---
# Separate from the OPENAI_* generation endpoint above - Weave Inference has
# no /v1/embeddings endpoint (404s), so this points at a different backend.
# Recommended local setup: an MLX embedding server on Apple Silicon serving
# mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ (top-tier open embedding
# model; verified against mlx-community/all-MiniLM-L6-v2-4bit with better
# ranking quality on real retrieval queries) via `mlx_embeddings` + a thin
# FastAPI /v1/embeddings wrapper - not yet a committed project script.
EMBEDDING_API_KEY=not-needed
EMBEDDING_BASE_URL=http://127.0.0.1:8712/v1
EMBEDDING_MODEL=mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ

# --- Weave tracing (data_gen/weave_logger.py) ---
# Optional: "<team>/<project>" traces are logged to. Independent of
# OPENAI_PROJECT above (that's the generation endpoint's header, this is the
# tracing destination) - set both to the same value if you want one project.
# Defaults to "tmax-data-gen" if unset.
WEAVE_PROJECT=
